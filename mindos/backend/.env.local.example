# ============================================
# MindOS — LOCAL DEV (.env.local)
# Bu fayl PyCharm orqali backend'ni TO'G'RIDAN-TO'G'RI ishga tushirish uchun.
# Faqat db va redis Docker'da ishlaydi: `docker-compose up db redis`
# Backend (FastAPI) esa PyCharm/terminal orqali to'g'ridan-to'g'ri ishlaydi.
#
# FARQI asosiy .env.example dan: "db" va "redis" o'rniga "localhost" ishlatilgan,
# chunki Docker konteyner ichidagi nom (db, redis) faqat Docker tarmog'i ichida ishlaydi.
# ============================================

APP_ENV=development
SECRET_KEY=local-dev-secret-key-kamida-32-belgi-bolishi-kerak-xxxx
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database (localhost — Docker portga chiqarilgan) ---
DATABASE_URL=postgresql+asyncpg://mindos:mindos_secret@localhost:5432/mindos_db

# --- Redis (localhost) ---
REDIS_URL=redis://localhost:6379/0
REDBEAT_REDIS_URL=redis://localhost:6379/1

# --- OpenAI (MAJBURIY — shu yersiz Curriculum/Mentor Agent ishlamaydi) ---
OPENAI_API_KEY=sk-your-real-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Telegram (ixtiyoriy — bo'sh qoldirsangiz bot ishlamaydi, lekin backend xato bermaydi) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# --- Stripe (ixtiyoriy — bo'sh qoldirsangiz checkout 503 qaytaradi, lekin boshqa hammasi ishlaydi) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# --- Email (ixtiyoriy — bo'sh qoldirsangiz email jim o'tkazib yuboriladi) ---
RESEND_API_KEY=
FROM_EMAIL=noreply@mindos.uz

# --- Sentry (ixtiyoriy) ---
SENTRY_DSN=

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:3000"]
